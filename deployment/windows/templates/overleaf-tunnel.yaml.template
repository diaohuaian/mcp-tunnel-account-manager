config_version: 1
control_plane:
  base_url: "https://api.openai.com"
  tunnel_id: "<TUNNEL_ID_PLACEHOLDER>"
  api_key: "env:CONTROL_PLANE_API_KEY"
health:
  listen_addr: "127.0.0.1:0"
admin_ui:
  open_browser: false
log:
  level: info
  format: json
mcp:
  commands:
    - channel: main
      command: "node servers/overleaf-mcp/node_modules/mcp-server-overleaf/dist/index.js --stdio"
