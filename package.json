{
  "name": "mcp-tunnel-account-manager",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Multi-account tunnel manager for Overleaf and Antigravity MCP with local-first secure vault",
  "scripts": {
    "start": "node src/main.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs --unit",
    "test:integration": "node scripts/run-tests.mjs --integration",
    "test:harness": "node --test tests/test-harness.test.mjs",
    "test:all": "node scripts/run-tests.mjs --all",
    "check": "node scripts/check.mjs",
    "validate-all": "node scripts/validate-all.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
